# Add this site to the existing, backed-up Caddy configuration only after
# validation. Connect that Caddy container to packing032_edge first.
# Do not replace the shared Caddyfile or start another listener on 80/443.
032-packing-scanner.noodzakelijkonline.de {
    request_body {
        max_size 16MB
    }
    reverse_proxy packing032:3001
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}
