{
  "name": "packing-scanning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "test": "vitest run",
    "benchmark": "node scripts/physical-benchmark.ts",
    "check:benchmarks": "tsc -p tsconfig.tools.json",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.ts",
    "api": "node --watch server/index.ts",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@types/node": "26.6.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.178.1",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  }
}
