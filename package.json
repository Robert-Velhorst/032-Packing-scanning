{
  "name": "packing-scanning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "test": "vitest run --maxWorkers=2",
    "benchmark": "node scripts/physical-benchmark.ts",
    "benchmark:optimizer": "node scripts/optimizer-performance.mjs",
    "benchmark:optimizer:profile": "node scripts/optimizer-performance.mjs --profile=true",
    "benchmark:optimizer:shapes": "node scripts/optimizer-performance.mjs --counts=20 --shapes=4",
    "benchmark:three-view": "node scripts/three-view-data-performance.mjs",
    "benchmark:three-surface": "node scripts/three-surface-performance.mjs",
    "benchmark:sequence": "node scripts/packing-sequence-performance.mjs",
    "benchmark:reconstruction": "node --expose-gc scripts/reconstruction-performance.mjs",
    "benchmark:interior": "node --expose-gc scripts/interior-cavity-performance.mjs",
    "check:benchmarks": "tsc -p tsconfig.tools.json",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.ts",
    "api": "node --watch server/index.ts",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "26.6.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "preact": "11.0.1",
    "preact-render-to-string": "6.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
